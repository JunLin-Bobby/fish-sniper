# Frontend origins allowed by CORS. Multiple values are comma-separated.
CORS_ORIGINS=http://localhost:5173

# Google OAuth 2.0 identity sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/google/callback

# FishSniper JWT signing. Use a long random secret in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=1

# Supabase server access. Never expose the secret key to the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Forecast provider timeouts and in-process cache lifetimes.
WEATHER_REQUEST_TIMEOUT_SECONDS=10
WEATHER_CACHE_TTL_SECONDS=1800

# Photos: private catch-photos bucket is created by the photo migration.
# Originals are discarded after conversion to JPEG. Keep these defaults in sync with UI hints.
CATCH_PHOTO_MAX_BYTES=20971520
CATCH_PHOTO_MAX_PIXELS=60000000
CATCH_PHOTO_MAX_EDGE=2048
CATCH_PHOTO_SIGNED_URL_SECONDS=300
# Whole receive/processing budgets, independent of individual provider HTTP timeouts.
CATCH_UPLOAD_RECEIVE_SECONDS=45
CATCH_UPLOAD_PROCESSING_SECONDS=30
# Retry persisted cleanup every minute; 0 disables automatic retries (CLI remains available).
CATCH_CLEANUP_INTERVAL_SECONDS=60
