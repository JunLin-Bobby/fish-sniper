# Allowed frontend origin for CORS — set to your Cloudflare Pages URL in production
FRONTEND_ORIGIN=http://localhost:5173

# Skip JWT validation — ONLY for local development, MUST be false/absent in production
SKIP_AUTH=false

# Fixed user id used when SKIP_AUTH=true (must exist in Supabase `users` if you hit protected routes)
SKIP_AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase (server-side only — never expose service role key to the browser)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=FishSniper <no-reply@yourdomain.com>

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# OpenWeatherMap (server-side only)
OPENWEATHERMAP_API_KEY=

# Gemini (server-side only) — used for BOTH battle-plan LLM AND embedding
# Reuses one GEMINI_API_KEY for both call sites (chat completions + embed_content).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash

# Gemini Embeddings (P4) — separate model id, same key as GEMINI_API_KEY above.
# gemini-embedding-001 supports Matryoshka output_dimensionality;
# 1536 keeps fishing_logs.embedding vector(1536) compatible across providers.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_EMBEDDING_TIMEOUT_SECONDS=5.0
GEMINI_EMBEDDING_MAX_ATTEMPTS=2

# Langfuse (optional — tracing disabled if either key is empty)
# Official env names match Langfuse docs: LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_BASE_URL
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Force OpenWeatherMap fetches to fail. When `manual_weather` is omitted, the
# strategy endpoint then returns 503; when provided, the override path makes this
# knob irrelevant (OWM is skipped entirely).
WEATHER_FAIL=false

# Per-email API rate limits (slowapi + moving window). Set false for some test environments.
RATE_LIMIT_ENABLED=true

# Synthetic email used as the rate-limit key when SKIP_AUTH=true
SKIP_AUTH_RATE_LIMIT_EMAIL=skip-auth-dev@fishsniper.local

# Bass strategy prompt bundle (backend/agent/prompts/<version>/). Default matches production.
STRATEGY_PROMPT_VERSION=v1_production

# Google OAuth 2.0 (identity-only sign-in). Get these from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application).
# Authorized redirect URIs in Console MUST match every entry in
# GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS (comma-separated) below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/google/callback
