# Frontend origins allowed by CORS. Multiple values are comma-separated.
CORS_ORIGINS=http://localhost:5173

# Google OAuth 2.0 identity sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/google/callback

# FishSniper JWT signing. Use a long random secret in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=1

# Supabase server access. Never expose the secret key to the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
