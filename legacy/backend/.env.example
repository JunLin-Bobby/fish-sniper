# Allowed frontend origin for CORS — set to your Cloudflare Pages URL in production
FRONTEND_ORIGIN=http://localhost:5173

# Skip JWT validation — ONLY for local development, MUST be false/absent in production
SKIP_AUTH=false

# Fixed user id used when SKIP_AUTH=true (must exist in Supabase `users` if you hit protected routes)
SKIP_AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase (server-side only — never expose service role key to the browser)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Per-IP Google OAuth exchange rate limits. Set false for some test environments.
RATE_LIMIT_ENABLED=true

# Synthetic email used as the rate-limit key when SKIP_AUTH=true
SKIP_AUTH_RATE_LIMIT_EMAIL=skip-auth-dev@fishsniper.local

# Google OAuth 2.0 (identity-only sign-in). Get these from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application).
# Authorized redirect URIs in Console MUST match every entry in
# GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS (comma-separated) below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/google/callback
