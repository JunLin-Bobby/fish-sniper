# FastAPI backend base URL
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 (identity-only sign-in). Match the values configured in:
#   * backend/.env GOOGLE_OAUTH_CLIENT_ID
#   * Google Cloud Console -> OAuth Client -> Authorized redirect URIs
# Leave VITE_GOOGLE_OAUTH_CLIENT_ID empty to disable the Google button.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
